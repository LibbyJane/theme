{% comment %}
    Renders the product custom metadata according to type (rating, integer, string etc)

    Usage:
    {% render render 'custom-metadata', product: product, block: block %}
{% endcomment %}

{%- style -%}
    .product-attributes.product-attributes {
    display: grid;
        gap: var(--space-sm);
        grid-template-columns: max-content auto;
        font-size: var(--font-size-smaller);
    margin: 0 0 var(--space-med);
    padding: 0;
    }

    .product-attributes .pa-label {
    font-size: var(--font-size-smaller);
    }

    .pa-rating-value {
    display: flex;
    position: relative;
    font-size: var(--font-size-small);
    }

    .pa-rating {
    background: rgba(var(--color-foreground), 0.2);
    border-radius: 99em;
    height: var(--space-med);
    width: 100%;
    overflow: hidden;
    position: relative;

    }

    .pa-progress-fill {
    background: rgb(var(--color-success));
    display: flex;
        align-items: center;
        justify-content: start;
        height: 100%;
    border-radius: 99em;
    color: rgb(var(--color-foreground));
    font-weight: bold;
    font-size: var(--font-size-small);
    transition: width var(--duration-long) var(--transition-type), background-color var(--duration-long) var(--transition-type);
    }

    .pa-value {
    position: relative;
    z-index: 1;
    padding: 0 var(--space-sm);
    }
{%- endstyle -%}

{%- assign ns_handle = block.settings.metafield_namespace | default: 'custom' -%}
{%- assign ns = product.metafields[ns_handle] -%}

{%- assign hidden_keys_csv = block.settings.hidden_keys_csv | default: 'internal_note,seo_handle,debug_only' -%}
{%- assign hidden_keys = hidden_keys_csv | split: ',' -%}

{%- comment -%}
  Render order of groups. 'list.' matches any list.* type.
  Final bucket is 'other' (anything not matched earlier).
{%- endcomment -%}
{% assign group_order = 'rating|number_decimal|number_integer|measurement|boolean|list.|json|other' | split: '|' %}

{%- if ns != blank -%}
    {%- comment -%}
        Order the groups here. You can tweak or add more.
        'list.' matches any list.* type via "contains".
    {%- endcomment -%}
    {% assign group_order = 'rating|number_decimal|number_integer|measurement|boolean|list.|json|other' | split: '|' %}

    <h1>hidden keys {{  hidden_keys }}</h1>

    <dl class="product-attributes">
        {% for bucket in group_order %}
            {%- comment -%} Optional: show a small heading per group (remove if not wanted) {%- endcomment -%}
            {%- assign show_heading = block.settings.show_group_headings -%}
            {%- capture heading -%}
                {%- case bucket -%}
                    {%- when 'rating' -%} Ratings
                    {%- when 'number_decimal' -%} Decimals
                    {%- when 'number_integer' -%} Integers
                    {%- when 'measurement' -%} Measurements
                    {%- when 'boolean' -%} Booleans
                    {%- when 'list.' -%} Lists
                    {%- when 'json' -%} Other
                    {%- else -%} Other
                {%- endcase -%}
            {%- endcapture -%}

        {%- assign printed_any = false -%}

        {%- for pair in ns -%}
            {%- assign key = pair | first -%}
            {%- if hidden_keys contains key -%}{%- continue -%}{%- endif -%}

            {%- assign mf  = ns[key] -%}
            {%- assign t   = mf.type -%}
            
            {%- assign in_bucket = false -%}

            {%- if bucket == 'list.' and t contains 'list.' -%}
                {%- assign in_bucket = true -%}

            {%- elsif bucket == t -%}
                {%- assign in_bucket = true -%}

            {%- elsif bucket == 'other' -%}
                {%- unless t == 'rating'
                        or t == 'number_decimal'
                        or t == 'number_integer'
                        or t == 'measurement'
                        or t == 'boolean'
                        or t contains 'list.'
                        or t == 'json' -%}
                    {%- assign in_bucket = true -%}
                {%- endunless -%}
            {%- endif -%}

            {%- unless in_bucket -%}{% continue %}{%- endunless -%}

            {%- if printed_any == false and show_heading -%}
                <dt class="h5">{{ heading }}</dt><dd class="spacer"></dd>
                {%- assign printed_any = true -%}
            {%- endif -%}

            {%- assign label = key | replace: '_', ' ' | capitalize -%}
            {%- assign css = 'pa-default' -%}
            {%- assign is_rating = false -%}
            {%- assign output = '' -%}

            {%- case t -%}
                {%- when 'list.single_line_text_field', 'list.number_integer', 'list.number_decimal' -%}
                    {% assign output = mf.value | join: ', ' %}

                {%- when 'boolean' -%}
                    {% assign output = mf.value | default: false %}
                    {% assign output = output | replace: 'true', 'Yes' | replace: 'false', 'No' %}

                {%- when 'number_integer', 'number_decimal' -%}
                    {% assign output = mf.value %}

                {%- when 'measurement' -%}
                    {% assign output = mf.value.value | append: ' ' | append: mf.value.unit %}

                {%- when 'rating' -%}
                    {% assign r = mf.value %}
                    {% assign rating = r.value | default: r.rating | default: r | plus: 0 %}
                    {% assign rating_max = r.scale_max | default: r.max | default: 10 | plus: 0 %}
                    {% assign percent = rating | times: 100 | divided_by: rating_max %}
                    {% assign turn = rating | times: 0.1 | plus: 0.28 %}
                    {% if turn > 1 %}{% assign turn = 1 %}{% endif %}
                    {% assign is_rating = true %}
                    {% assign css = 'pa-rating-value' %}

                {%- when 'json' -%}
                    {%- assign data = mf.value | parse_json -%}
                    {%- if data.size and data.first -%}
                        {% assign output = data | join: ', ' %}
                    {%- elsif data.value and data.unit -%}
                        {% assign output = data.value | append: ' ' | append: data.unit %}
                    {%- else -%}
                        {% assign output = mf.value %}
                    {%- endif -%}

                {%- else -%}
                    {% assign output = mf.value %}
            {%- endcase -%}

            <dt class="pa-label">{{ label }} / hidden_keys {{ hidden_keys }} / {%- if hidden_keys contains key -%}should be hidden{%- endif -%}</dt>
            <dd class="{{ css }}">
                {% if is_rating %}
                    <div class="pa-rating">
                        <div class="pa-progress-fill" style="width: {{ percent }}%; filter: hue-rotate({{ turn }}turn);">
                            <span class="pa-value">{{ rating | round: 1 }}</span>
                        </div>
                    </div><span class="pa-rating--max">&nbsp;/&nbsp;{{ rating_max }}</span>
                {% else %}
                    {{ output }}
                {% endif %}
            </dd>
            {%- endfor -%}
        {% endfor %}
    </dl>
{% endif %}
