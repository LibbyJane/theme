{% comment %}
  Custom metadata (two buckets):
  - Ratings
  - Details (everything else)
  Usage:
  {% render 'custom-metadata', product: product, block: block %}
{% endcomment %}

{%- style -%}
  .product-attributes.product-attributes {
    display: grid;
    gap: var(--space-sm);
    grid-template-columns: max-content auto;
    font-size: var(--font-size-smaller);
    margin: 0 0 var(--space-med);
    padding: 0;
  }
  .product-attributes .pa-label { font-size: var(--font-size-smaller); }
  .pa-rating-value { display: flex; position: relative; font-size: var(--font-size-small); }
  .pa-rating {
    background: rgba(var(--color-foreground), 0.2);
    border-radius: 99em;
    height: var(--space-med);
    width: 100%;
    overflow: hidden;
    position: relative;
  }
  .pa-progress-fill {
    background: rgb(var(--color-success));
    display: flex; align-items: center; justify-content: start;
    height: 100%;
    border-radius: 99em;
    color: rgb(var(--color-foreground));
    font-weight: bold;
    font-size: var(--font-size-small);
    transition: width var(--duration-long) var(--transition-type),
                background-color var(--duration-long) var(--transition-type);
  }
  .pa-value { position: relative; z-index: 1; padding: 0 var(--space-sm); }
  .pa-group { margin-block: var(--space-sm); }
  .pa-group summary { list-style: none; cursor: pointer; }
  .pa-group summary::-webkit-details-marker { display:none; }
  .pa-group-title { margin: 0 0 var(--space-sm); }
  .pa-heading-spacer { margin: 0; }
{%- endstyle -%}

{%- assign ns_handle = block.settings.metafield_namespace | default: 'custom' -%}
{%- assign ns = product.metafields[ns_handle] -%}
{%- assign hidden_keys = (block.settings.hidden_keys_csv | default: '') | split: ',' | map: 'strip' -%}

{%- assign show_headings = block.settings.show_group_headings -%}
{%- assign collapsible  = block.settings.collapsible_groups -%}
{%- assign groups_open  = block.settings.groups_open_default | default: 'rating' | downcase | split: ',' | map: 'strip' -%}

{%- if ns != blank -%}

  {%- comment -%}
    Helper: renders one bucket.
    Params:
      bucket: 'rating' or 'details'
      title:  heading text
  {%- endcomment -%}
  {%- capture render_bucket -%}{% raw %}
    {%- assign _bucket = include.bucket -%}
    {%- assign _title  = include.title -%}
    {%- assign _printed_any = false -%}

    {%- capture bucket_body -%}
      <dl class="product-attributes">
        {%- for pair in ns -%}
          {%- assign key = pair | first | strip -%}
          {%- if hidden_keys contains key -%}{%- continue -%}{%- endif -%}

          {%- assign mf = ns[key] -%}
          {%- assign t  = mf.type -%}

          {%- assign in_bucket = false -%}
          {%- if _bucket == 'rating' and t == 'rating' -%}
            {%- assign in_bucket = true -%}
          {%- elsif _bucket == 'details' and t != 'rating' -%}
            {%- assign in_bucket = true -%}
          {%- endif -%}
          {%- unless in_bucket -%}{%- continue -%}{%- endunless -%}

          {%- assign _printed_any = true -%}

          {%- assign label = key | replace: '_', ' ' | capitalize -%}
          {%- assign css = 'pa-default' -%}
          {%- assign is_rating = false -%}
          {%- assign output = '' -%}

          {%- case t -%}
            {%- when 'list.single_line_text_field', 'list.number_integer', 'list.number_decimal' -%}
              {%- assign output = mf.value | join: ', ' -%}

            {%- when 'boolean' -%}
              {%- assign output = mf.value | default: false -%}
              {%- assign output = output | replace: 'true','Yes' | replace: 'false','No' -%}

            {%- when 'number_integer', 'number_decimal' -%}
              {%- assign output = mf.value -%}

            {%- when 'measurement' -%}
              {%- assign output = mf.value.value | append: ' ' | append: mf.value.unit -%}

            {%- when 'rating' -%}
              {%- assign r = mf.value -%}
              {%- assign rating = r.value | default: r.rating | default: r | plus: 0 -%}
              {%- assign rating_max = r.scale_max | default: r.max | default: 10 | plus: 0 -%}
              {%- assign percent = rating | times: 100 | divided_by: rating_max -%}
              {%- assign turn = rating | times: 0.1 | plus: 0.28 -%}
              {%- if turn > 1 -%}{%- assign turn = 1 -%}{%- endif -%}
              {%- assign is_rating = true -%}
              {%- assign css = 'pa-rating-value' -%}

            {%- when 'json' -%}
              {%- assign data = mf.value -%}
              {%- if data.size and data.first -%}
                {%- assign output = data | join: ', ' -%}
              {%- elsif data.value and data.unit -%}
                {%- assign output = data.value | append: ' ' | append: data.unit -%}
              {%- else -%}
                {%- assign output = mf.value -%}
              {%- endif -%}

            {%- else -%}
              {%- assign output = mf.value -%}
          {%- endcase -%}

          <dt class="pa-label">{{ label }}</dt>
          <dd class="{{ css }}">
            {%- if is_rating -%}
              <div class="pa-rating">
                <div class="pa-progress-fill" style="width: {{ percent }}%; filter: hue-rotate({{ turn }}turn);">
                  <span class="pa-value">{{ rating | round: 1 }}</span>
                </div>
              </div><span class="pa-rating--max">&nbsp;/&nbsp;{{ rating_max }}</span>
            {%- else -%}
              {{ output }}
            {%- endif -%}
          </dd>
        {%- endfor -%}
      </dl>
    {%- endcapture -%}

    {%- if _printed_any -%}
      {%- assign group_handle = _bucket -%}
      {%- assign should_open = groups_open contains group_handle -%}

      {%- if collapsible -%}
        <details class="pa-group" {% if should_open %}open{% endif %}>
          <summary>
            {%- if show_headings -%}
              <h5 class="pa-group-title">{{ _title }}</h5>
            {%- endif -%}
          </summary>
          {{ bucket_body }}
        </details>
      {%- else -%}
        <div class="pa-group">
          {%- if show_headings -%}
            <h5 class="pa-group-title">{{ _title }}</h5>
          {%- endif -%}
          {{ bucket_body }}
        </div>
      {%- endif -%}
    {%- endif -%}
  {% endraw %}{%- endcapture -%}

  {%- comment -%} Render: Ratings first, then Details {%- endcomment -%}
  {%- render render_bucket, bucket: 'rating',  title: 'Ratings' -%}
  {%- render render_bucket, bucket: 'details', title: 'Details' -%}

{%- endif -%}
