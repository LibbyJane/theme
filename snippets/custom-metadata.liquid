{% comment %}
  Custom metadata (two buckets):
  - Ratings
  - Details (everything else)
  Usage:
  {% render 'custom-metadata', product: product, block: block %}
{% endcomment %}

{%- style -%}
  .product-attributes.product-attributes {
    display: grid;
    gap: var(--space-sm);
    grid-template-columns: max-content auto;
    font-size: var(--font-size-smaller);
    margin: 0 0 var(--space-med);
    padding: 0;
  }
  .product-attributes .pa-label {
    font-size: var(--font-size-smaller);
  }
  .pa-rating-value {
    display: flex;
    position: relative;
    font-size: var(--font-size-small);
  }
  .pa-rating {
    background: rgba(var(--color-foreground), 0.2);
    border-radius: 99em;
    height: var(--space-med);
    width: 100%;
    overflow: hidden;
    position: relative;
  }
  .pa-progress-fill {
    background: rgb(var(--color-success));
    display: flex;
    align-items: center;
    justify-content: start;
    height: 100%;
    border-radius: 99em;
    color: rgb(var(--color-foreground));
    font-weight: bold;
    font-size: var(--font-size-small);
    transition: width var(--duration-long) var(--transition-type),
      background-color var(--duration-long) var(--transition-type);
  }
  .pa-value {
    position: relative;
    z-index: 1;
    padding: 0 var(--space-sm);
  }
  .pa-group {
    margin-block: var(--space-sm);

    summary {
      list-style: none;
      cursor: pointer;
      display: flex;
      align-items: center;

      svg {
        margin-bottom: var(--space-sm);
      }
    }
  }

  .pa-group summary::-webkit-details-marker {
    display: none;
  }
  .pa-group-title {
    margin: 0 0 var(--space-sm);
  }
{%- endstyle -%}

{%- assign ns_handle = block.settings.metafield_namespace | default: 'custom' -%}
{%- assign ns = product.metafields[ns_handle] -%}

{%- comment -%}
  Normalize CSVs: remove spaces before splitting so "a, b" matches "a" and "b"
{%- endcomment -%}
{%- assign hidden_keys_csv = block.settings.hidden_keys_csv | default: '' | replace: ' ', '' -%}
{%- assign hidden_keys = hidden_keys_csv | split: ',' -%}

{%- assign show_headings = block.settings.show_group_headings -%}
{%- assign collapsible = block.settings.collapsible_groups -%}
{%- assign groups_open_csv = block.settings.groups_open_default
  | default: 'rating,details'
  | downcase
  | replace: ' ', ''
-%}
{%- assign groups_open = groups_open_csv | split: ',' -%}

{%- if ns != blank -%}
  {%- comment -%} ------- BUCKET: RATINGS ------- {%- endcomment -%}
   <h1>ns {{ ns }}</h1>
  {%- assign printed_any = false -%}
  {%- capture ratings_body -%}
    <dl class="product-attributes">
      {%- for pair in ns -%}
        {%- assign key = pair | first -%}
        {%- if hidden_keys contains key -%}{%- continue -%}{%- endif -%}
        {%- assign mf = ns[key] -%}
        {%- if mf.type != 'rating' -%}{%- continue -%}{%- endif -%}
        {%- assign printed_any = true -%}

        {%- assign label = key | replace: '_', ' ' | capitalize -%}
        {%- assign r = mf.value -%}
        {%- assign rating = r.value | default: r.rating | default: r | plus: 0 -%}
        {%- assign rating_max = r.scale_max | default: r.max | default: 10 | plus: 0 -%}
        {%- assign percent = rating | times: 100 | divided_by: rating_max -%}
        {%- assign turn = rating | times: 0.1 | plus: 0.1 -%}
        {%- if turn > 1 -%}{%- assign turn = 1 -%}{%- endif -%}
        {%- if turn < 0.825 -%}{%- assign turn = 0.825 -%}{%- endif -%}

        <dt class="pa-label">{{ label }}</dt>
        <dd class="pa-rating-value">
          <div class="pa-rating">
            <div class="pa-progress-fill" style="width: {{ percent }}%; filter: hue-rotate({{ turn }}turn);">
              <span class="pa-value">{{ rating | round: 1 }}</span>
            </div>
          </div><span class="pa-rating--max">&nbsp;/&nbsp;{{ rating_max }}</span>
        </dd>
      {%- endfor -%}
    </dl>
  {%- endcapture -%}

  {%- if printed_any -%}
    {%- assign group_handle = 'rating' -%}
    {%- capture heading_html -%}
      {% if show_headings %}
          <h5 class="pa-group-title">Ratings</h5>
        {% endif %}
    {%- endcapture -%}
    {%- if collapsible -%}
      <details
        class="pa-group"
        {% if groups_open_csv contains group_handle %}
          open
        {% endif %}
      >
        <summary>
          {{ heading_html }}
          {% render 'icon-caret' %}
        </summary>
        {{ ratings_body }}
      </details>
    {%- else -%}
      <div class="pa-group">
        {{ heading_html }}
        {{ ratings_body }}
      </div>
    {%- endif -%}
  {%- endif -%}

  {%- comment -%} ------- BUCKET: DETAILS (everything else) ------- {%- endcomment -%}
  {%- assign printed_any = false -%}
  {%- capture details_body -%}
    <dl class="product-attributes">
      {%- for pair in ns -%}
        {%- assign key = pair | first -%}
        {%- if hidden_keys contains key -%}{%- continue -%}{%- endif -%}
        {%- assign mf = ns[key] -%}
        {%- if mf.type == 'rating' -%}{%- continue -%}{%- endif -%}
        {%- assign printed_any = true -%}

        {%- assign label = key | replace: '_', ' ' | capitalize -%}
        {%- assign css = 'pa-default' -%}
        {%- assign output = '' -%}

        {%- case mf.type -%}
          {%- when 'list.single_line_text_field', 'list.number_integer', 'list.number_decimal' -%}
            {%- assign output = mf.value | join: ', ' -%}
          {%- when 'boolean' -%}
            {%- assign output = mf.value | default: false -%}
            {%- assign output = output | replace: 'true', 'Yes' | replace: 'false', 'No' -%}
          {%- when 'number_integer', 'number_decimal' -%}
            {%- assign output = mf.value -%}
          {%- when 'measurement' -%}
            {%- assign output = mf.value.value | append: ' ' | append: mf.value.unit -%}
          {%- when 'json' -%}
            {%- assign data = mf.value -%}
            {%- if data.size and data.first -%}
              {%- assign output = data | join: ', ' -%}
            {%- elsif data.value and data.unit -%}
              {%- assign output = data.value | append: ' ' | append: data.unit -%}
            {%- else -%}
              {%- assign output = mf.value -%}
            {%- endif -%}
          {%- else -%}
            {%- assign output = mf.value -%}
        {%- endcase -%}

        <dt class="pa-label">{{ label }}</dt>
        <dd class="{{ css }}">{{ output }}</dd>
      {%- endfor -%}
    </dl>
  {%- endcapture -%}

  {%- if printed_any -%}
    {%- assign group_handle = 'details' -%}
    {%- if collapsible -%}
      <details
        class="pa-group"
        {% if groups_open contains group_handle %}
          open
        {% endif %}
      >
        <summary>
          {% if show_headings %}
            <h5 class="pa-group-title">Details</h5>
          {% endif %}
        </summary>
        {{ details_body }}
      </details>
    {%- else -%}
      <div class="pa-group">
        {% if show_headings %}
          <h5 class="pa-group-title">Details</h5>
        {% endif %}
        {{ details_body }}
      </div>
    {%- endif -%}
  {%- endif -%}
{%- endif -%}
