    },
    {
      "type": "range",
      "id": "title_margin_bottom",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Title margin bottom",
      "default": 24
    },
    {
      "type": "range",
      "id": "grid_margin_top",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Grid margin top",
      "default": 32
    },
    {
      "type": "range",
      "id": "card_padding",
      "min": 8,
      "max": 40,
      "step": 4,
      "unit": "px",
